# Copy to .env (or export as real environment variables) before running the backend.

DB_URL=jdbc:postgresql://localhost:5432/dbwb
DB_USERNAME=dbwb_user
DB_PASSWORD=changeme

JWT_SECRET=change-this-to-a-long-random-string-in-every-environment
JWT_ACCESS_TTL_MIN=60

CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_SITE_BASE_URL=http://localhost:3000

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# TBD-012: real support mailbox pending business decision.
SUPPORT_NOTIFICATION_EMAIL=support@example.com

# One-time bootstrap for the platform's first Super Admin account (blank = skipped).
# Leave unset in normal operation once the first admin exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

MENU_IMPORT_MAX_FILE_SIZE_MB=10

# Where uploaded images (logos, cover photos, gallery, menu/service photos) go.
#
# local  - this container's disk. Development only: the files are lost when the
#          container is replaced, and a second instance cannot see them.
# r2     - Cloudflare R2. Set the four R2_* values below. A public bucket is
#          served from Cloudflare's network, so this is the CDN as well and
#          there is nothing extra to put in front of it.
UPLOAD_STORAGE=local
UPLOAD_DIRECTORY=uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# Cloudflare R2, required when UPLOAD_STORAGE=r2.
# Account id and bucket come from the R2 dashboard; the access key pair from
# "Manage R2 API Tokens" - give it Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public address: its r2.dev URL, or a custom domain you attach.
# Make the bucket public in Cloudflare first - R2 ignores per-object ACLs, so
# nothing the application sends can grant read access on its own.
R2_PUBLIC_BASE_URL=

# Request-rate ceilings are set in application.yml (dbwb.rate-limits.*) rather
# than here - they are policy, not per-environment secrets. Set
# DBWB_RATELIMITS_ENABLED=false only for local load testing.
#
# Behind a reverse proxy also set SERVER_FORWARD_HEADERS_STRATEGY=framework, or
# every request will look like it comes from the proxy's own address and share
# one allowance.

# AI content-suggestion assistant, via OpenRouter. Leave the key blank to disable
# the feature entirely (the endpoint returns a clear error instead of failing oddly).
# Swap OPENROUTER_MODEL to any other OpenRouter model id without a code change.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

SERVER_PORT=8080
