# Copy to .env (or export as real environment variables) before running the backend.

DB_URL=jdbc:postgresql://localhost:5432/dbwb
DB_USERNAME=dbwb_user
DB_PASSWORD=changeme

JWT_SECRET=change-this-to-a-long-random-string-in-every-environment
JWT_ACCESS_TTL_MIN=60

CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_SITE_BASE_URL=http://localhost:3000

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# TBD-012: real support mailbox pending business decision.
SUPPORT_NOTIFICATION_EMAIL=support@example.com

# One-time bootstrap for the platform's first Super Admin account (blank = skipped).
# Leave unset in normal operation once the first admin exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

MENU_IMPORT_MAX_FILE_SIZE_MB=10

# Local disk storage for uploaded images (logos, cover photos, gallery, menu/service photos).
UPLOAD_DIRECTORY=uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# Request-rate ceilings are set in application.yml (dbwb.rate-limits.*) rather
# than here - they are policy, not per-environment secrets. Set
# DBWB_RATELIMITS_ENABLED=false only for local load testing.
#
# Behind a reverse proxy also set SERVER_FORWARD_HEADERS_STRATEGY=framework, or
# every request will look like it comes from the proxy's own address and share
# one allowance.

# AI content-suggestion assistant, via OpenRouter. Leave the key blank to disable
# the feature entirely (the endpoint returns a clear error instead of failing oddly).
# Swap OPENROUTER_MODEL to any other OpenRouter model id without a code change.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

SERVER_PORT=8080
